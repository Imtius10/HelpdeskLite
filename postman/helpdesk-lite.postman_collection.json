                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns aggregated statistics', () => {",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.byStatus).to.have.all.keys(",
                  "    'OPEN',",
                  "    'IN_PROGRESS',",
                  "    'RESOLVED',",
                  "    'CLOSED',",
                  "  );",
                  "  pm.expect(body.byPriority).to.have.all.keys('LOW', 'MEDIUM', 'HIGH');",
                  "  pm.expect(body.unassigned).to.be.a('number');",
                  "});",
                  "pm.test('counts the ticket moved to in progress', () => {",
                  "  pm.expect(body.byStatus.IN_PROGRESS).to.be.greaterThan(0);",
                  "});"
