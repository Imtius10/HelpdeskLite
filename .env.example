# HTTP server
PORT=3000

# SQLite database file (use :memory: for an ephemeral database)
DATABASE_PATH=data/helpdesk.db

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Demo seed data (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_AGENT_EMAIL=agent@helpdesk.local
SEED_AGENT_PASSWORD=Agent123!
SEED_CUSTOMER_EMAIL=customer@helpdesk.local
SEED_CUSTOMER_PASSWORD=Customer123!

# Optional NestJS Observe credentials (instrumentation is disabled when empty)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=helpdesk-lite
